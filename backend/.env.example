# MongoDB (replace with your MongoDB connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smart_e_fining?retryWrites=true&w=majority


# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Stripe (TEST MODE ONLY — get keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Admin auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Seed-only: used once by seed.js to create the first Super Admin.
# Change this and re-seed in any real deployment.
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe123!
